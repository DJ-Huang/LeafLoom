# Copy to .env in this folder (vault-rag). Cursor MCP can also set the same env keys.

VAULT_ROOT=C:\ExampleVault Knowledge\DJ knowledge
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=bge-m3

# Index inside vault (default true): VAULT_ROOT + VAULT_INDEX_FOLDER
INDEX_IN_VAULT=true
VAULT_INDEX_FOLDER=.vault-rag

# If INDEX_IN_VAULT=false, use INDEX_DIR under the vault-rag project instead:
# INDEX_DIR=_index

# Merge vault/.ragignore (gitignore-style) if present
LOAD_RAGIGNORE_FILE=true

# Skip any .md under a path whose directory segment starts with '.' (e.g. .obsidian/, .codely-cli/)
# Default true. Set to false if you intentionally keep notes under dot-folders.
EXCLUDE_DOT_PREFIXED_DIR_SEGMENTS=true

# Extra gitignore-style patterns, pipe-separated (relative to vault root)
# EXCLUDE_PATHSPEC_EXTRA=Export/**|Attachments/**|Inbox/scratch/**

# Directory segment blacklist (JSON array string; merged with built-ins)
# EXCLUDE_DIR_NAMES_EXTRA=[".sync","Archive","Attachments"]

# Legacy: substring excludes on relative path, comma-separated
# EXCLUDE_GLOBS=old-export/,temp/
