# The web / HTTP MCP service keeps directory selection in:
# macOS: ~/Library/Application Support/VaultRag/config.json
# Windows: %LOCALAPPDATA%\VaultRag\config.json
# Change it through http://127.0.0.1:18080/ settings.
# No Ollama variables or .env file are required for the shared service.
# Optional private state location for a separate installation:
# VAULT_RAG_HOME=/absolute/path/to/private/state

# Compatibility settings for legacy scoped audit helpers only:
VAULT_ROOT=/absolute/path/to/knowledge
VAULT_CONTENT_FOLDER=RAG
VAULT_RULES_FOLDER=Rules
INDEX_IN_VAULT=true
VAULT_INDEX_FOLDER=.vault-rag
LOAD_RAGIGNORE_FILE=true
EXCLUDE_DOT_PREFIXED_DIR_SEGMENTS=true
